# ===========================================================================
# IMS WhatsApp FAQ Bot — copie para .env e preencha
# O arquivo .env NUNCA vai para o Git (ver .gitignore).
# ===========================================================================

# --- Onde o bot pode agir -------------------------------------------------
# JIDs dos grupos, separados por virgula. Rode `npm run groups` depois de
# parear o numero para descobrir o JID do seu GRUPO DE TESTE.
# Comece SEMPRE com o grupo de teste, nunca com o grupo real.
TARGET_GROUP_IDS=

# Numeros dos admins que recebem as sinalizacoes (categorias B/D), com DDI.
# Ex.: 5511999999999,5521988888888
ADMIN_NUMBERS=

# Modo observacao: processa e loga, mas nao envia NADA.
# Deixe em `true` ate ver os logs do grupo de teste fazendo sentido.
DRY_RUN=true

# --- Regra central de categorias -----------------------------------------
# Categorias que o bot pode responder sozinho.
AUTO_REPLY_CATEGORIES=A,C,E
# Categorias que o bot NUNCA responde — apenas avisa os admins no privado.
# B = Legalidade, D = Uso/preparacao/seguranca.
RESTRICTED_CATEGORIES=B,D

# Confianca minima (0..1) para responder automaticamente.
CONFIDENCE_THRESHOLD=0.75
# Confianca minima para sinalizar categoria restrita aos admins.
# Mais baixa de proposito: na duvida, acordar um humano.
RESTRICTED_FLAG_THRESHOLD=0.55

# Quanto o melhor candidato de A/C/E precisa superar o melhor de B/D para que
# a resposta automatica saia. Abaixo disso a mensagem e tratada como ambigua
# e vai para os admins em vez de ser respondida.
AMBIGUITY_MARGIN=0.10

# Rede de seguranca: mensagens contendo qualquer um destes termos NUNCA sao
# auto-respondidas — vao direto para os admins, qualquer que seja o score.
# Existe porque nome de farmaco fora do vocabulario do FAQ pontua baixo e
# escaparia do limiar. Deixe em branco para usar a lista default do config.ts;
# escreva uma lista propria para substituir; use SAFETY_KEYWORDS= com um espaco
# para desligar.
SAFETY_KEYWORDS=

# --- Anti-spam ------------------------------------------------------------
# Nao repetir a mesma resposta para a mesma pessoa dentro de N horas.
COOLDOWN_HOURS=24
# Nao repetir a mesma sinalizacao aos admins dentro de N horas.
ADMIN_NOTIFY_COOLDOWN_HOURS=6
# Teto de respostas automaticas por hora (janela deslizante).
MAX_REPLIES_PER_HOUR=6
# Atraso "humano" antes de responder (ms).
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
# Mensagens menores que isso nunca sao tratadas como pergunta.
MIN_MESSAGE_LENGTH=12

# --- Matching semantico ---------------------------------------------------
# none   = apenas lexical (offline, sem custo, sem chave) — default
# openai = embeddings via API compativel com OpenAI
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# Peso do componente semantico no score final (0..1). Ignorado se provider=none.
SEMANTIC_WEIGHT=0.65

# --- Infra ----------------------------------------------------------------
WA_AUTH_DIR=./auth_info
DB_PATH=./data/bot.sqlite
LOG_LEVEL=info
MAX_RECONNECT_ATTEMPTS=10
